+/* Whether the display refreshes at 119.88 Hz: a thread woken late (the title's
+ * other threads busy at start-up) misses vblanks, so the intervals between
+ * waits are whole numbers of vblanks, and at 59.94 Hz every one is a multiple
+ * of 16.68 ms. One interval an odd number of 8.34 ms periods long shows the
+ * high rate (Frequency, 2026-11-23: waits every 2 and 3 vblanks, a 20.9 ms
+ * median, and 59.94 Hz restored on a display at 119.88 Hz). */
+static bool
+videoout_vblank_shows_high_rate(int handle)
+{
+   const uint64_t half = UINT64_C(8341675), slack = UINT64_C(2000000);
+   if (sceVideoOutWaitVblank(handle) != 0)
+      return false;
+   uint64_t previous = os_time_get_nano();
+   for (unsigned at = 0; at < 4 * VIDEOOUT_PERIOD_INTERVALS; at++) {
+      if (sceVideoOutWaitVblank(handle) != 0)
+         return false;
+      const uint64_t now = os_time_get_nano();
+      const uint64_t interval = now - previous;
+      previous = now;
+      const uint64_t halves = (interval + half / 2) / half;
+      const uint64_t off = interval > halves * half ? interval - halves * half : halves * half - interval;
+      if ((halves & 1) != 0 && off < slack)
+         return true;
+   }
+   return false;
+}
+
